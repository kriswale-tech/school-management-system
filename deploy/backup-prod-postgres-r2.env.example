# Copy to .backup.env on the VPS, fill in values, then chmod 600 .backup.env.
# Keep this separate from .env.prod; this token is scoped to the backup bucket.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=schoolassist-prod-backups

# age public recipient (age1...). The matching private identity is needed only
# for restores and must be stored securely outside the VPS.
BACKUP_AGE_RECIPIENT=

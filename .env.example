# Local Compose environment. Deployed stacks must set APP_ENV=development or
# APP_ENV=production and provide the corresponding hostnames/origins below.
APP_ENV=local
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep a different value in each environment. Never commit the generated value.
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

POSTGRES_DB=sms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

FRONTEND_BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3003
# Vite API URL is public build/runtime configuration, never a secret.
VITE_API_BASE_URL=http://localhost:9000/api/v1
# Platform admin Vite app (Compose publishes host :3004 → container :5174)
PLATFORM_ADMIN_URL=http://localhost:3004
PLATFORM_MFA_ISSUER=SCHOOLASST Platform
PLATFORM_MFA_PENDING_MINUTES=10
PUBLIC_BASE_URL=http://localhost:9000
RECEIPT_LINK_MAX_AGE_SECONDS=2592000
REPORT_LINK_MAX_AGE_SECONDS=2592000
FEE_SCHEDULE_LINK_MAX_AGE_SECONDS=7776000

# Notification email (Amazon SES). Host Redis is published on 6380.
# Without AWS creds, EMAIL_PROVIDER=ses still falls back to console mail so
# local flows work before you create an AWS account.
EMAIL_ENABLED=false
EMAIL_PROVIDER=ses
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_WEBHOOK_AUTH_TOKEN=
SES_CONFIGURATION_SET=sms-email-events
SES_SNS_TOPIC_ARN=
MESSAGING_AUTO_REFUND_FAILED_SMS=true
MESSAGING_AUTO_REFUND_FAILED_EMAIL=true
# Hold school SMS when the Arkesel balance reading is older than this.
ARKESEL_FLOAT_MAX_AGE_MINUTES=90
# Email platform admins when the wallet covers fewer than this many days of recent SMS.
ARKESEL_LOW_BALANCE_DAYS=3
ARKESEL_USAGE_LOOKBACK_DAYS=7
ARKESEL_ALERT_COOLDOWN_HOURS=24
DEFAULT_FROM_EMAIL=noreply@your-verified-domain.com
# Legacy (unused): RESEND_API_KEY=  RESEND_WEBHOOK_SECRET=

ARKESEL_API_KEY=
ARKESEL_SMS_SENDER=SCHOOLASST
ARKESEL_SANDBOX=true

# Paystack SaaS renewals / capacity upgrades / communication top-ups (GHS).
# Keep separate from any school-fee Paystack credentials.
PAYSTACK_SAAS_SECRET_KEY=
PAYSTACK_SAAS_PUBLIC_KEY=
PAYSTACK_SAAS_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
# Root folder for logos and profile pictures. Subfolders stay school-logos/ and profile-pictures/.
CLOUDINARY_ROOT_FOLDER=school-management-system

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_SIGNED_URL_EXPIRE_SECONDS=3600

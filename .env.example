DEBUG=True
SECRET_KEY=change-me

POSTGRES_DB=sms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

FRONTEND_BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3003
# Platform admin Vite app (compose publishes host :3004 → container :5174)
PLATFORM_ADMIN_URL=http://localhost:3004
PLATFORM_MFA_ISSUER=SCHOOLASST Platform
PLATFORM_MFA_PENDING_MINUTES=10
PUBLIC_BASE_URL=http://localhost:9000
RECEIPT_LINK_MAX_AGE_SECONDS=2592000
REPORT_LINK_MAX_AGE_SECONDS=2592000
FEE_SCHEDULE_LINK_MAX_AGE_SECONDS=7776000

# Notification email (Amazon SES). Host Redis is published on 6380.
# Without AWS creds, EMAIL_PROVIDER=ses still falls back to console mail so
# local flows work before you create an AWS account.
EMAIL_ENABLED=false
EMAIL_PROVIDER=ses
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_WEBHOOK_AUTH_TOKEN=
MESSAGING_AUTO_REFUND_FAILED_SMS=true
MESSAGING_AUTO_REFUND_FAILED_EMAIL=true
DEFAULT_FROM_EMAIL=noreply@your-verified-domain.com
# Legacy (unused): RESEND_API_KEY=  RESEND_WEBHOOK_SECRET=

ARKESEL_API_KEY=
ARKESEL_SMS_SENDER=SCHOOLASST

# Paystack SaaS renewals / capacity upgrades / communication top-ups (GHS).
# Keep separate from any school-fee Paystack credentials.
PAYSTACK_SAAS_SECRET_KEY=
PAYSTACK_SAAS_PUBLIC_KEY=
PAYSTACK_SAAS_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_SIGNED_URL_EXPIRE_SECONDS=3600
